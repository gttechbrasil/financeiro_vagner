generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  name         String
  passwordHash String
}

// Plano de contas do DRE gerencial.
// group: RECEITA | DEDUCAO | CUSTO | DESPESA | FINANCEIRO | NAO_OPERACIONAL | PRO_LABORE | DISTRIBUICAO
// Grupos fora do DRE (classificáveis, mas não somam no DRE nem nos KPIs): TRANSFERENCIA | PESSOAL
model DreAccount {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  group        String
  sortOrder    Int
  active       Boolean       @default(true)
  transactions Transaction[]
  rules        Rule[]
  suppliers    Supplier[]
}

model Sector {
  id           String        @id @default(cuid())
  name         String        @unique
  transactions Transaction[]
  rules        Rule[]
  suppliers    Supplier[]
}

model Unit {
  id           String        @id @default(cuid())
  name         String        @unique
  transactions Transaction[]
  rules        Rule[]
  suppliers    Supplier[]
}

// Fornecedor: detectado pela descrição do lançamento (contém `pattern`;
// se vazio, usa o próprio nome). A classificação padrão (conta/setor/unidade)
// é aplicada automaticamente na importação quando nenhuma regra específica casar.
model Supplier {
  id               String        @id @default(cuid())
  name             String        @unique
  pattern          String?
  defaultAccount   DreAccount?   @relation(fields: [defaultAccountId], references: [id])
  defaultAccountId String?
  defaultSector    Sector?       @relation(fields: [defaultSectorId], references: [id])
  defaultSectorId  String?
  defaultUnit      Unit?         @relation(fields: [defaultUnitId], references: [id])
  defaultUnitId    String?
  active           Boolean       @default(true)
  transactions     Transaction[]
}

// kind: ASAAS | CONTA_CORRENTE | CARTAO_CREDITO
model BankAccount {
  id           String        @id @default(cuid())
  name         String        @unique
  kind         String        @default("CONTA_CORRENTE")
  active       Boolean       @default(true)
  transactions Transaction[]
}

model ImportBatch {
  id           String        @id @default(cuid())
  fileName     String
  source       String
  // arquivo original importado, para consulta posterior a partir do lançamento
  fileData     Bytes?
  fileMime     String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id            String       @id @default(cuid())
  date          DateTime
  description   String
  // valor em centavos, com sinal: crédito positivo, débito negativo
  amountCents   Int
  bankAccount   BankAccount  @relation(fields: [bankAccountId], references: [id])
  bankAccountId String
  account       DreAccount?  @relation(fields: [accountId], references: [id])
  accountId     String?
  sector        Sector?      @relation(fields: [sectorId], references: [id])
  sectorId      String?
  unit          Unit?        @relation(fields: [unitId], references: [id])
  unitId        String?
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])
  supplierId    String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  importBatchId String?
  externalId    String?
  hash          String       @unique
  notes         String?
  // despesa fixa mensal: entra na previsão dos meses futuros do DRE
  recurring     Boolean      @default(false)
  // compra parcelada: parcela atual e total (ex.: 6 de 10) — as parcelas
  // restantes são projetadas nos meses futuros do DRE
  installmentNum   Int?
  installmentTotal Int?
  createdAt     DateTime     @default(now())

  @@index([date])
  @@index([accountId])
  @@index([bankAccountId])
  @@index([supplierId])
}

// Regra de classificação automática: se a descrição contém `pattern`
// (sem diferenciar maiúsculas), aplica conta/setor/unidade.
model Rule {
  id        String      @id @default(cuid())
  pattern   String
  account   DreAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  sector    Sector?     @relation(fields: [sectorId], references: [id])
  sectorId  String?
  unit      Unit?       @relation(fields: [unitId], references: [id])
  unitId    String?
  priority  Int         @default(0)
  active    Boolean     @default(true)
}
